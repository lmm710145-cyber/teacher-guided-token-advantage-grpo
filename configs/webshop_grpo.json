{
  "seed": 42,
  "cutoff_length": 4096,
  "max_new_tokens": 256,
  "group_size": 4,
  "batch_size": 32,
  "max_concurrent_trajectories": 32,
  "environment_workers": 4,
  "vllm_memory_utilization": 0.8,
  "max_num_batched_tokens": 8192,
  "enable_prefix_caching": false,
  "enforce_eager": false,
  "lora_r": 16,
  "lora_alpha": 32,
  "max_steps": 100,
  "eval_steps": [
    0,
    5,
    10,
    25,
    50,
    75,
    100
  ],
  "learning_rate": 2e-06,
  "warmup_steps": 5,
  "kl_beta": 0.01,
  "clip_epsilon": 0.2,
  "training_micro_batch": 2,
  "scoring_micro_batch": 2,
  "head_chunk_size": 128,
  "padded_token_budget": 16384,
  "sampling": {
    "temperature": 1.0,
    "top_p": 1.0,
    "top_k": -1
  },
  "dev_sampling": {
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": -1
  },
  "optimizer_steps_per_batch": 1,
  "teacher_temperature": 1.0,
  "student_baseline_temperature": 1.0,
  "teacher_top_k": 64,
  "token_lambda": 0.5,
  "opd_weight": 0.5,
  "max_candidate_groups_per_update": 256,
  "max_collection_seconds": 7200,
  "filter_constant_groups": true,
  "preflight_memory_fraction": 0.9,
  "inference_python": "envs/inference/bin/python",
  "bench_python": "envs/bench/bin/python",
  "train_python": "envs/train/bin/python",
  "benchmark": "webshop",
  "max_turns": 10,
  "train_data": "data/processed/webshop/rl_train.jsonl",
  "dev_data": "data/processed/webshop/rl_dev.jsonl",
  "student_model": "models/Qwen3-1.7B",
  "teacher_model": "models/Qwen3-4B",
  "parent_checkpoint": "artifacts/student_sft_adapter",
  "teacher_checkpoint": "artifacts/teacher_grpo_adapter",
  "method": "grpo"
}
